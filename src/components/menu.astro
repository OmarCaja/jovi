---
// The menu as line tabs. Rendered on the server with a small script (no React island),
// so the tabs work as soon as the page loads, even on a weak signal in the old town.
// Without JS the tab row is hidden and every group shows in full under its own heading.
import type { MenuGroup } from "@/i18n/menu"
import type { Lang } from "@/i18n/ui"
import { formatPrice } from "@/i18n/utils"

interface Props {
  groups: MenuGroup[]
  lang: Lang
  allergensLabel: string
  /** Id of the section heading that names this tab list ("Para comer", "Para beber"). */
  labelledBy: string
}

const { groups, lang, allergensLabel, labelledBy } = Astro.props
---

<div data-tabs class="flex flex-col gap-10">
  <div
    role="tablist"
    aria-labelledby={labelledBy}
    class="relative -mx-4 flex w-[calc(100%+2rem)] flex-nowrap items-center justify-start gap-x-6 overflow-x-auto border-b border-border px-4 pb-2 [scrollbar-width:none] md:mx-0 md:w-full md:flex-wrap md:gap-y-2 md:overflow-visible md:px-0 md:pb-3 [html:not(.js)_&]:hidden [&::-webkit-scrollbar]:hidden"
  >
    {
      groups.map((g, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${g.id}`}
          aria-controls={`panel-${g.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={g.id}
          class="relative inline-flex min-h-11 flex-none items-center py-1 text-base font-medium whitespace-nowrap text-muted-foreground transition-colors hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none aria-selected:text-foreground md:min-h-0"
        >
          {g.label}
        </button>
      ))
    }
    {/* One underline that slides to the selected tab; the script sets its size and position. */}
    <span
      data-indicator
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-0 h-0.5 origin-left bg-primary motion-safe:transition-[transform,width] motion-safe:duration-500 motion-safe:ease-[cubic-bezier(0.16,1,0.3,1)]"
    ></span>
  </div>
  {
    groups.map((g, i) => (
      <div
        role="tabpanel"
        id={`panel-${g.id}`}
        aria-labelledby={`tab-${g.id}`}
        data-panel={g.id}
        data-active={i === 0 ? "" : undefined}
        tabindex="0"
        class="grid gap-12 focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:ring-offset-8 focus-visible:ring-offset-background focus-visible:outline-none [.js_&:not([data-active])]:hidden"
      >
        <h3 class="text-3xl [.js_&]:hidden">{g.label}</h3>
        {g.sections.map((s, si) => (
          <div>
            {/* The first section often repeats the tab name ("Cócteles" under "Cócteles"). */}
            {s.title && !(si === 0 && s.title === g.label) && <h3 class="mb-5 text-2xl text-primary">{s.title}</h3>}
            <ul class="columns-1 gap-x-12 sm:columns-2 lg:columns-3">
              {s.items.map((d) => (
                <li class="break-inside-avoid py-1.5 text-base">
                  <div class="flex items-baseline gap-3">
                    <span>{d.title}</span>
                    <span aria-hidden="true" class="min-w-4 flex-1 translate-y-[-3px] border-b border-dotted border-border" />
                    <span class="whitespace-nowrap text-muted-foreground tabular-nums">{formatPrice(d.price, lang)}</span>
                  </div>
                  {(d.desc || d.allergens) && (
                    <p class="mt-0.5 text-sm text-muted-foreground">
                      {d.desc}
                      {d.desc && d.allergens && ". "}
                      {d.allergens && (
                        <span>
                          {allergensLabel} {d.allergens}
                        </span>
                      )}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
        {g.note && <p class="text-muted-foreground">{g.note}</p>}
      </div>
    ))
  }
</div>

<script>
  import { gsap } from "gsap"
  import { onPage } from "@/lib/page"

  onPage(() => {
    const roots = document.querySelectorAll<HTMLElement>("[data-tabs]")
    if (!roots.length) return
    // Deep link from the landing page: /carta/?tab=coffees opens that tab.
    const urlTab = new URLSearchParams(location.search).get("tab")
    const cleanups: (() => void)[] = []

    roots.forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")]
      const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")]
      const indicator = root.querySelector<HTMLElement>("[data-indicator]")!
      // Sits 5px under the tab's label, following it across wrapped rows and the scrolling row on phones.
      const place = () => {
        const t = tabs.find((t) => t.getAttribute("aria-selected") === "true")!
        indicator.style.width = `${t.offsetWidth}px`
        indicator.style.transform = `translate(${t.offsetLeft}px, ${t.offsetTop + t.offsetHeight + 5}px)`
      }
      const select = (id: string, focus = false, animate = true) => {
        if (panels.find((p) => p.hasAttribute("data-active"))?.dataset.panel === id) animate = false
        tabs.forEach((t) => {
          const on = t.dataset.tab === id
          t.setAttribute("aria-selected", String(on))
          t.tabIndex = on ? 0 : -1
          if (on && focus) t.focus()
        })
        panels.forEach((p) => p.toggleAttribute("data-active", p.dataset.panel === id))
        place()
        // The new list deals in from just below, top to bottom; long lists cap the stagger at 0.3s.
        const panel = panels.find((p) => p.dataset.panel === id)!
        if (animate && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          gsap.fromTo(
            panel.querySelectorAll("h3, li, :scope > p"),
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: 0.5, ease: "power3.out", stagger: { amount: 0.3 }, overwrite: true }
          )
        }
      }
      // First placement without the slide, so the underline is simply there on load.
      indicator.style.transition = "none"
      select(urlTab && tabs.some((t) => t.dataset.tab === urlTab) ? urlTab : tabs[0].dataset.tab!, false, false)
      indicator.getBoundingClientRect()
      indicator.style.transition = ""
      // Fonts and the md breakpoint move the labels; keep the underline under them.
      const ro = new ResizeObserver(place)
      ro.observe(root)
      cleanups.push(() => ro.disconnect())

      tabs.forEach((t, i) => {
        t.addEventListener("click", () => select(t.dataset.tab!))
        // Arrow keys move along the row (automatic activation), Home/End jump to the ends.
        t.addEventListener("keydown", (e) => {
          const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key]
          if (to === undefined) return
          e.preventDefault()
          select(tabs[(to + tabs.length) % tabs.length].dataset.tab!, true)
        })
      })
    })
    return () => cleanups.forEach((c) => c())
  })
</script>
