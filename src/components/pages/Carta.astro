---
import Layout from "@/layouts/main.astro"
import Menu from "@/components/menu.astro"
import { drinkGroups, foodGroups } from "@/i18n/menu"
import { allergenNames } from "@/i18n/ui"
import { getLangFromUrl, getTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = getTranslations(lang)
---

<Layout
  title={t("meta.menuTitle")}
  description={t("meta.menuDescription")}
>
  <div class="mx-auto max-w-7xl px-4 pt-32 pb-24 md:px-8 md:pt-40 md:pb-32">
    <h1 data-reveal class="text-5xl leading-[1.1] md:text-7xl">
      {t("menu.title")}
    </h1>

    <!-- Anchors sit on the sections, not the headings: the reveal transform on a heading
         would throw off where the browser scrolls to. -->
    <section id="comer" aria-labelledby="comer-title" class="scroll-mt-8 mt-16 md:mt-24">
      <h2 id="comer-title" data-reveal class="mb-10 text-4xl leading-[1.1] md:text-5xl">
        {t("menu.eat")}
      </h2>
      <div data-reveal>
        <Menu groups={foodGroups(lang)} lang={lang} allergensLabel={t("menu.allergens")} labelledBy="comer-title" />
      </div>
    </section>

    <section id="beber" aria-labelledby="beber-title" class="scroll-mt-8 mt-24 md:mt-32">
      <h2 id="beber-title" data-reveal class="mb-10 text-4xl leading-[1.1] md:text-5xl">
        {t("menu.drink")}
      </h2>
      <div data-reveal>
        <Menu groups={drinkGroups(lang)} lang={lang} allergensLabel={t("menu.allergens")} labelledBy="beber-title" />
      </div>
    </section>

    <aside class="mt-24 grid gap-8 border-t border-border pt-10 text-sm text-muted-foreground md:grid-cols-3">
      <p>{t("menu.prices")}</p>
      <div class="md:col-span-2">
        <h2 class="mb-3 font-sans text-sm text-foreground">{t("menu.allergens")}</h2>
        <ol class="grid grid-cols-2 gap-x-6 gap-y-1 sm:grid-cols-3 lg:grid-cols-4">
          {allergenNames[lang].map((a, i) => <li><span class="tabular-nums">{i + 1}.</span> {a}</li>)}
        </ol>
      </div>
    </aside>
  </div>
</Layout>
