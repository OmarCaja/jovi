---
// Hugeicons, rendered as static SVG at build time (same markup as @hugeicons/react,
// without shipping React). Icons are decorative: their links and buttons carry the name.
// The shape of every export of @hugeicons/core-free-icons (the package doesn't export the type).
type IconSvgObject = readonly (readonly [string, Readonly<Record<string, string | number>>])[]

interface Props {
  icon: IconSvgObject
  size?: number
  strokeWidth?: number
  class?: string
}

const { icon, size = 24, strokeWidth = 1.5, class: className } = Astro.props
const kebab = (k: string) => k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)
const parts = icon.map(([tag, attrs]) => {
  const { key: _, ...rest } = attrs
  const out = Object.fromEntries(Object.entries(rest).map(([k, v]) => [kebab(k), String(v)]))
  if ("stroke-width" in out) out["stroke-width"] = String(strokeWidth)
  return { Tag: tag, attrs: out }
})
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  class={className}
  aria-hidden="true"
>
  {parts.map(({ Tag, attrs }) => <Tag {...attrs} />)}
</svg>
