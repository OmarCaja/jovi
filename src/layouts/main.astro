---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"
import { buttonVariants } from "@/components/ui/button"
import { Image } from "astro:assets"
import { address, hours, mapsUrl } from "@/lib/site"
import bar from "@/assets/gallery/4.jpg"
import { languages } from "@/i18n/ui"
import { alternatePath, formatHours, getLangFromUrl, getTranslatedPath, getTranslations, withBase } from "@/i18n/utils"
import { HugeiconsIcon } from "@hugeicons/react"
import { InstagramIcon, Location01Icon } from "@hugeicons/core-free-icons"

interface Props {
  title?: string
  description?: string
}

const lang = getLangFromUrl(Astro.url)
const t = getTranslations(lang)
const localize = getTranslatedPath(lang)
const otherLang = lang === "es" ? "en" : "es"

const { title = t("meta.title"), description = t("meta.description") } = Astro.props

const noSlash = (p: string) => p.replace(/\/$/, "")
const path = noSlash(Astro.url.pathname)
const current = (href: string) => (noSlash(href) === path ? "page" : undefined)
const home = localize("/")
const nav = [
  { href: `${home}#casa`, label: t("nav.house") },
  { href: localize("/carta"), label: t("nav.menu") },
  { href: localize("/galeria"), label: t("nav.gallery") },
]
const switchHref = alternatePath(Astro.url, otherLang)

// Page transition: only <main> moves; header and footer hold still between pages.
const pageSwap = {
  forwards: {
    old: { name: "page-out", duration: "180ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-in", duration: "520ms", delay: "60ms", easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "page-out", duration: "180ms", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "page-in", duration: "520ms", delay: "60ms", easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
}
---

<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1a14" />
    <link
      rel="icon"
      type="image/png"
      href={withBase("/favicon/favicon-96x96.png")}
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon/favicon.svg")} />
    <link rel="shortcut icon" href={withBase("/favicon/favicon.ico")} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase("/favicon/apple-touch-icon.png")}
    />
    <meta name="apple-mobile-web-app-title" content="Jovi" />
    <link rel="manifest" href={withBase("/favicon/site.webmanifest")} />
    <title>{title}</title>
    <ClientRouter />
    <link rel="alternate" hreflang={otherLang} href={new URL(switchHref, Astro.site)} />
    <script is:inline>
      document.documentElement.classList.add("js")
    </script>
  </head>
  <body class="antialiased">
    <header
      transition:name="site-header"
      transition:animate="none"
      class="fixed inset-x-0 top-0 z-40 border-b border-border bg-background/85 pt-[env(safe-area-inset-top)] backdrop-blur-md transition-colors duration-300 [[data-menu-open]_&]:bg-background"
    >
      <nav
        class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:px-8"
        aria-label={t("nav.primary")}
      >
        <a href={home} class="flex min-h-11 items-center font-heading text-2xl font-semibold tracking-[-0.03em]">Taberna Jovi</a>
        <ul
          class="hidden items-center gap-8 text-sm text-muted-foreground md:flex"
        >
          {
            nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  aria-current={current(n.href)}
                  class="transition-colors hover:text-foreground aria-[current=page]:text-foreground"
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-2 max-md:hidden">
          <a
            href={switchHref}
            hreflang={otherLang}
            lang={otherLang}
            aria-label={t("lang.switch")}
            class="grid h-10 min-w-11 place-items-center rounded-full px-3 text-sm font-semibold tracking-[0.04em] text-muted-foreground uppercase transition-colors hover:bg-foreground/10 hover:text-foreground"
          >{otherLang}</a>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener"
            class={buttonVariants({ variant: "outline", className: "h-10 px-5" })}
            >{t("cta.directions")}</a
          >
        </div>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t("nav.open")}
          data-label-open={t("nav.open")}
          data-label-close={t("nav.close")}
          class="group -mr-2 grid size-11 place-items-center rounded-full transition-colors duration-300 hover:bg-foreground/10 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 md:hidden"
        >
          <span aria-hidden="true" class="relative block h-[11px] w-[18px]">
            <span
              class="absolute inset-x-0 top-0 h-[1.5px] rounded-full bg-current transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-expanded:translate-y-[4.75px] group-aria-expanded:rotate-45"
            ></span>
            <span
              class="absolute inset-x-0 bottom-0 h-[1.5px] rounded-full bg-current transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-expanded:-translate-y-[4.75px] group-aria-expanded:-rotate-45"
            ></span>
          </span>
        </button>
      </nav>
    </header>

    <!-- Mobile menu: a sheet that drops from under the header, over the dimmed bar photo. -->
    <div
      id="mobile-menu"
      aria-hidden="true"
      class="invisible fixed inset-0 isolate z-30 flex flex-col overflow-y-auto bg-background pt-[calc(4rem+env(safe-area-inset-top))] md:hidden"
    >
      <div data-menu-bg class="pointer-events-none absolute inset-0 -z-10">
        <Image
          src={bar}
          alt=""
          widths={[480, 768, 1024]}
          width={1024}
          sizes="100vw"
          class="h-full w-full object-cover object-[50%_40%] opacity-35"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-background via-background/80 to-background"></div>
      </div>
      <nav
        aria-label={t("nav.mobile")}
        class="flex flex-1 flex-col justify-between gap-12 px-4 pt-10 pb-[max(1.5rem,env(safe-area-inset-bottom))]"
      >
        <ul class="grid">
          {
            [{ href: home, label: t("nav.home") }, ...nav].map((n) => (
              <li class="overflow-hidden">
                <a
                  href={n.href}
                  data-menu-link
                  aria-current={current(n.href)}
                  class="block py-1.5 font-heading text-[clamp(2.75rem,13vw,3.75rem)] leading-[1.1] font-semibold tracking-[-0.035em] transition-colors aria-[current=page]:text-primary"
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div data-menu-foot class="grid gap-6">
          <div class="grid gap-1 text-base">
            {
              hours.map((h) => (
                <p data-days={h.days.join(",")} class="hidden data-[today]:block">
                  <span class="text-muted-foreground">{t("today")} </span>
                  <span class="text-primary">{formatHours(h.time, lang).toLowerCase()}</span>
                </p>
              ))
            }
            <p class="text-muted-foreground">{address.street}, {address.city}</p>
          </div>
          <a
            href={switchHref}
            hreflang={otherLang}
            lang={otherLang}
            data-menu-lang
            class="-my-2 inline-flex min-h-11 items-center self-start text-base text-muted-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:text-foreground"
          >{languages[otherLang]}</a>
          <div class="flex items-center gap-3">
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener"
              class={buttonVariants({ size: "lg", className: "h-14 flex-1 gap-2 text-base" })}
            >
              <HugeiconsIcon icon={Location01Icon} size={18} strokeWidth={1.75} />
              {t("cta.directions")}
            </a>
            <a
              href="https://www.instagram.com/tabernajovi/"
              target="_blank"
              rel="noopener"
              aria-label={t("instagram")}
              class="grid size-14 place-items-center rounded-full border border-foreground/30 transition-colors hover:border-foreground/60 hover:bg-foreground/10"
            >
              <HugeiconsIcon icon={InstagramIcon} size={22} strokeWidth={1.5} />
            </a>
          </div>
        </div>
      </nav>
    </div>

    <main transition:animate={pageSwap}>
      <slot />
    </main>

    <footer transition:name="site-footer" transition:animate="none" class="border-t border-border">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-2 px-4 pt-8 pb-[max(2rem,env(safe-area-inset-bottom))] text-sm text-muted-foreground md:flex-row md:items-center md:justify-between md:px-8 md:py-8"
      >
        <span class="font-heading text-lg font-semibold tracking-[-0.02em] text-foreground">Taberna Jovi</span>
        <nav aria-label={t("nav.footer")} class="-my-1 flex gap-6 md:hidden">
          {nav.map((n) => <a href={n.href} class="py-3">{n.label}</a>)}
        </nav>
        <div class="flex items-center gap-6">
          <span>{address.street}, {address.city}</span>
          <a
            href="https://www.instagram.com/tabernajovi/"
            target="_blank"
            rel="noopener"
            aria-label={t("instagram")}
            class="-m-3 p-3 transition-colors hover:text-foreground"
          >
            <HugeiconsIcon icon={InstagramIcon} size={20} strokeWidth={1.5} />
          </a>
        </div>
      </div>
    </footer>

    <script>
      import { gsap } from "gsap"
      import { ScrollTrigger } from "gsap/ScrollTrigger"
      import { onPage } from "@/lib/page"

      gsap.registerPlugin(ScrollTrigger)

      const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches

      // The router swaps <html> attributes for the new page's, which drops the "js" class
      // the inline head script added on first load. Put it back before the new page paints.
      document.addEventListener("astro:after-swap", () => document.documentElement.classList.add("js"))

      // Page-independent listeners, registered once; they act on whichever menu is current.
      let setMenu: (open: boolean) => void = () => {}
      let menuOpen = false
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menuOpen) {
          setMenu(false)
          document.querySelector<HTMLButtonElement>("[data-menu-toggle]")?.focus()
        }
      })
      matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setMenu(false))

      onPage(() => {
        // Today's opening hours, in Cuenca's time zone (home hours table and the mobile menu).
        // ponytail: ignores the after-midnight tail of the previous night (Saturday 01:00 still shows Saturday).
        const today = new Date(new Date().toLocaleString("en-US", { timeZone: "Europe/Madrid" })).getDay()
        document.querySelectorAll<HTMLElement>("[data-days]").forEach((row) => {
          if (row.dataset.days!.split(",").map(Number).includes(today)) row.dataset.today = ""
        })

        // Mobile menu.
        const menu = document.querySelector<HTMLElement>("#mobile-menu")!
        const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")!
        const links = [...menu.querySelectorAll<HTMLElement>("[data-menu-link]")]
        const foot = menu.querySelector<HTMLElement>("[data-menu-foot]")!
        const menuBg = menu.querySelector<HTMLElement>("[data-menu-bg]")!
        const outside = [document.querySelector("main"), document.querySelector("footer")]
        let menuTl: gsap.core.Timeline | undefined
        menuOpen = false

        setMenu = (open: boolean) => {
          if (open === menuOpen) return
          menuOpen = open
          toggle.setAttribute("aria-expanded", String(open))
          toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen)!)
          menu.setAttribute("aria-hidden", String(!open))
          outside.forEach((el) => el && ((el as HTMLElement).inert = open))
          document.documentElement.toggleAttribute("data-menu-open", open)
          document.documentElement.style.overflow = open ? "hidden" : ""
          menuTl?.kill()

          if (open) {
            gsap.set(menu, { visibility: "visible" })
            menuTl = reduced()
              ? gsap.timeline().fromTo(menu, { opacity: 0 }, { opacity: 1, duration: 0.2 })
              : gsap
                  .timeline()
                  // The sheet drops from under the header like a blind, the photo settles,
                  // then each line rises out of its own mask.
                  .fromTo(menu, { clipPath: "inset(0% 0% 100% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 0.6, ease: "expo.out" })
                  .fromTo(menuBg, { scale: 1.08, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.2, ease: "power2.out" }, 0)
                  .fromTo(links, { yPercent: 110 }, { yPercent: 0, duration: 0.7, ease: "expo.out", stagger: 0.06 }, 0.12)
                  .fromTo(foot, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 0.32)
            links[0].focus({ preventScroll: true })
          } else {
            menuTl = (
              reduced()
                ? gsap.timeline().to(menu, { opacity: 0, duration: 0.2 })
                : gsap
                    .timeline()
                    .to([foot, ...links], { opacity: 0, duration: 0.15 })
                    .to(menu, { clipPath: "inset(0% 0% 100% 0%)", duration: 0.4, ease: "power3.inOut" }, 0.05)
            ).eventCallback("onComplete", () => {
              gsap.set(menu, { visibility: "hidden" })
              gsap.set([menu, menuBg, foot, ...links], { clearProps: "opacity,clipPath,transform" })
            })
          }
        }

        toggle.addEventListener("click", () => setMenu(!menuOpen))
        links.forEach((l) => l.addEventListener("click", () => setMenu(false)))

        // Motion only when the user allows it; reduced-motion users get static content (CSS never hides it for them).
        const mm = gsap.matchMedia()
        mm.add("(prefers-reduced-motion: no-preference)", () => {
          // Hero entry (home only): sequence the message and unveil the photo.
          if (document.querySelector("[data-hero]")) {
            gsap
              .timeline({ defaults: { ease: "power3.out" } })
              .fromTo(
                "[data-hero-image] img",
                { opacity: 0, scale: 1.08 },
                { opacity: 1, scale: 1, duration: 1.8, ease: "power2.out" }
              )
              .fromTo(
                "[data-hero]",
                { opacity: 0, y: 24 },
                { opacity: 1, y: 0, duration: 0.9, stagger: 0.12 },
                0.2
              )
          }

          // Scroll reveal: each block fades up once as it enters, pacing the story.
          gsap.set("[data-reveal]", { y: 32 })
          ScrollTrigger.batch("[data-reveal]", {
            start: "top 88%",
            once: true,
            onEnter: (els) =>
              gsap.to(els, {
                opacity: 1,
                y: 0,
                duration: 0.9,
                stagger: 0.1,
                ease: "power3.out",
              }),
          })
        })

        return () => {
          menuTl?.kill()
          mm.revert()
        }
      })
    </script>
  </body>
</html>
